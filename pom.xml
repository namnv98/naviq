<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://www.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sqlctx</groupId>
    <artifactId>sqlctx</artifactId>
    <version>1.0.0</version>

    <properties>
        <antlr4.version>4.13.1</antlr4.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- JLine 3 — all-in-one uber jar (terminal + reader + completers) -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>4.3.1</version>
        </dependency>
        <!-- Các dep khác của bạn -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr4.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.8.0.25.04</version>
        </dependency>
        <!-- Cần cho SSL/TLS qua Oracle wallet (oracle.net.wallet_location, xem OracleDataSource.applySsl) -
             ojdbc11 KHÔNG tự kéo theo các jar này, thiếu thì driver ném "SSO KeyStore not available" dù
             cwallet.sso tồn tại và đúng định dạng (đã kiểm chứng bằng thực nghiệm). -->
        <dependency>
            <groupId>com.oracle.database.security</groupId>
            <artifactId>oraclepki</artifactId>
            <version>23.8.0.25.04</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.security</groupId>
            <artifactId>osdt_cert</artifactId>
            <version>21.18.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.security</groupId>
            <artifactId>osdt_core</artifactId>
            <version>21.18.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>
        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.vmware.antlr4-c3</groupId>
            <artifactId>antlr4-c3</artifactId>
            <version>1.1</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>

            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <id>postgresql</id>
                        <configuration>
                            <visitor>true</visitor>
                            <listener>true</listener>
                            <sourceDirectory>src/main/antlr4/postgresql</sourceDirectory>
                            <outputDirectory>
                                ${project.build.directory}/generated-sources/antlr4/com/sqlctx/antlr4/postgresql
                            </outputDirectory>
                        </configuration>
                    </execution>

                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <id>oracle</id>
                        <configuration>
                            <visitor>true</visitor>
                            <listener>true</listener>
                            <sourceDirectory>src/main/antlr4/oracle</sourceDirectory>
                            <outputDirectory>
                                ${project.build.directory}/generated-sources/antlr4/com/sqlctx/antlr4/oracle
                            </outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.sqlctx.cli.SqlctxCli</mainClass>
                                    <manifestEntries>
                                        <!-- JLine's FFM terminal provider dùng java.lang.foreign (restricted API) -
                                             thiếu dòng này thì MỌI lần chạy đều in ra 3-4 dòng WARNING native access
                                             ra stderr. Khai báo thẳng trong manifest (thay vì bắt người dùng luôn
                                             phải nhớ gõ cờ enable native access) để chạy kiểu gì
                                             (java -jar trực tiếp, script cài qua install.sh, run.sh...) cũng im lặng. -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <!-- postgresql VÀ ojdbc11 đều tự đăng ký qua META-INF/services/java.sql.Driver -
                                     không gộp thì shade chỉ giữ lại 1 trong 2 file (đè lên nhau), driver còn lại
                                     "biến mất" (DriverManager báo "No suitable driver found") dù jar vẫn có mặt. -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>process-sources</phase>  <!-- đổi từ generate-sources -->
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/antlr4</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>